[Unit]
Description=Why Smart Money AI - Next.js Dashboard Frontend
After=network.target why-smart-money-backend.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/why-smart-money/frontend
Environment="NODE_ENV=production"
Environment="PORT=3000"
Environment="NEXT_PUBLIC_API_URL=http://localhost:8000"
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
