# WHY SMART MONEY AI - Environment Configuration Template
# Copy this file to .env for local configuration

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_TIMEZONE=America/Toronto
PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Market Data & Brokerage Providers
# Leave as ENTER_API_KEY_HERE to run safely in DEMO MODE with synthetic, realistic data
ALPACA_API_KEY=ENTER_API_KEY_HERE
ALPACA_SECRET_KEY=ENTER_API_KEY_HERE
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Polygon / Massive Market Data API
MASSIVE_API_KEY=ENTER_API_KEY_HERE

# Financial News Data Provider
NEWS_API_KEY=ENTER_API_KEY_HERE

# Database Connection (Defaults to SQLite if left unset or set to ENTER_DATABASE_URL_HERE)
# SQLite fallback: sqlite:///./smart_money.db
# PostgreSQL: postgresql://user:password@localhost:5432/smart_money
DATABASE_URL=ENTER_DATABASE_URL_HERE

# Redis Connection (Optional for Windows local dev; in-memory caching fallback used if empty)
REDIS_URL=redis://localhost:6379/0

# LLM Grounded Explanation & Narrative Engine
# Used strictly for synthesizing structured metrics and evidence into natural language
ANTHROPIC_API_KEY=ENTER_API_KEY_HERE

# Notification Channels (Daily 5 AM Morning Brief & Alert Signals)
TELEGRAM_BOT_TOKEN=ENTER_API_KEY_HERE
TELEGRAM_CHAT_ID=ENTER_CHAT_ID_HERE

# Risk & Trading Execution Guardrails
ENABLE_LIVE_TRADING=false
REQUIRE_EXPLICIT_CONFIRMATION=true
DEFAULT_MAX_POSITION_SIZE_PCT=0.05
DEFAULT_MAX_PORTFOLIO_RISK_PCT=0.02
MAX_SLIPPAGE_TOLERANCE_BPS=15
